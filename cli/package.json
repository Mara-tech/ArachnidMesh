{
  "name": "@mara-tech/arachnid-mesh",
  "version": "0.1.0",
  "description": "Install and update agent tooling — skills, rules and permissions — into your project",
  "type": "module",
  "bin": {
    "arachnid-mesh": "./src/index.js"
  },
